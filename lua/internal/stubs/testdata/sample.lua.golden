--- An object key, "group:class", of a registered Game Object.
---@alias GodObject
---| "ext:Thing" # Thing has its own Transform.
---| "game:Boss"
---| "game:Hero" # Hero is the player character.

--- An opaque entity handle. It may be stored and compared with ==.
---@class Entity

--- The table a script returns. T is the object class `update` receives.
---@class GodScript<T>
---@field object GodObject The Game Object the script runs for.
---@field init? fun() Called once when the script is loaded.
---@field update fun(dt: number, e: Entity, obj: T) Called once per matching entity per tick.

---@alias god.ext.Stamp any

--- A transform with a name.
---@class god.ext.Transform
---@field Label string

---@class god.game.Companion
---@field Attachment? god.game.Companion.Attachment
---@field Name string
---@field Owner? Entity The object that owns the companion.
---@field Tags? string[]

---@class god.game.Companion.Attachment
---@field Name string

--- Health is hit points.
---
--- It never drops below zero.
---@class god.game.Health
---@field Current integer
---@field Max integer

--- Score is not used by any object yet.
---@class god.game.Score
---@field Mode integer How points are counted.
---@field Points integer

--- Transform is a position.
---@class god.game.Transform
---@field X number Horizontal | position.
---@field Y number

---@class god.game.Weapon
---@field Cooldown? number
---@field Damage number
---@field Icon? string

--- Thing has its own Transform.
---@class ext.Thing
---@field ["ext:Transform"] god.ext.Transform
---@field Transform god.ext.Transform
---@field ["ext:Stamp"] god.ext.Stamp
---@field Stamp god.ext.Stamp

---@class game.Boss
---@field ["game:Transform"] god.game.Transform (embedded via Common)
---@field Transform god.game.Transform (embedded via Common)

--- Hero is the player character.
---
--- It can carry a weapon.
---@class game.Hero
---@field ["game:Transform"] god.game.Transform Where the hero is. (embedded via Common.Base)
---@field Transform god.game.Transform Where the hero is. (embedded via Common.Base)
---@field ["game:Health"] god.game.Health Stores the hero's health.
---@field Health god.game.Health Stores the hero's health.
---@field ["game:Companion"] god.game.Companion (readonly)
---@field Companion god.game.Companion (readonly)
---@field ["game:Weapon"] god.game.Weapon? The weapon the hero carries, if any.
---@field Weapon? god.game.Weapon The weapon the hero carries, if any.

--- The Game Object API of the lua module. Structural changes are queued and applied after the stage.
world = {}

--- Queues the despawn of an entity.
---@param e Entity
function world.despawn(e) end

--- Validates the components now and queues the creation of a new entity.
---@param object GodObject
---@param components table
---@overload fun(object: "ext:Thing", components: ext.Thing)
---@overload fun(object: "game:Boss", components: game.Boss)
---@overload fun(object: "game:Hero", components: game.Hero)
function world.spawn(object, components) end

--- Validates the value now and queues adding or replacing one component.
---@param e Entity
---@param object GodObject
---@param component string
---@param value table
---@overload fun(e: Entity, object: "ext:Thing", component: "ext:Transform", value: god.ext.Transform)
---@overload fun(e: Entity, object: "ext:Thing", component: "Transform", value: god.ext.Transform)
---@overload fun(e: Entity, object: "ext:Thing", component: "ext:Stamp", value: god.ext.Stamp)
---@overload fun(e: Entity, object: "ext:Thing", component: "Stamp", value: god.ext.Stamp)
---@overload fun(e: Entity, object: "game:Boss", component: "game:Transform", value: god.game.Transform)
---@overload fun(e: Entity, object: "game:Boss", component: "Transform", value: god.game.Transform)
---@overload fun(e: Entity, object: "game:Hero", component: "game:Transform", value: god.game.Transform)
---@overload fun(e: Entity, object: "game:Hero", component: "Transform", value: god.game.Transform)
---@overload fun(e: Entity, object: "game:Hero", component: "game:Health", value: god.game.Health)
---@overload fun(e: Entity, object: "game:Hero", component: "Health", value: god.game.Health)
---@overload fun(e: Entity, object: "game:Hero", component: "game:Companion", value: god.game.Companion)
---@overload fun(e: Entity, object: "game:Hero", component: "Companion", value: god.game.Companion)
---@overload fun(e: Entity, object: "game:Hero", component: "game:Weapon", value: god.game.Weapon)
---@overload fun(e: Entity, object: "game:Hero", component: "Weapon", value: god.game.Weapon)
function world.set(e, object, component, value) end

--- Queues the removal of an optional component.
---@param e Entity
---@param object GodObject
---@param component string
---@overload fun(e: Entity, object: "game:Hero", component: "game:Weapon")
---@overload fun(e: Entity, object: "game:Hero", component: "Weapon")
function world.remove(e, object, component) end

--- An object for the entity, or nil if it lacks a required component. Valid for the current call only.
---@param e Entity
---@param object GodObject
---@return table?
---@overload fun(e: Entity, object: "ext:Thing"): ext.Thing?
---@overload fun(e: Entity, object: "game:Boss"): game.Boss?
---@overload fun(e: Entity, object: "game:Hero"): game.Hero?
function world.get(e, object) end

--- The components of the entity as a Lua table (a copy).
---@param e Entity
---@param object GodObject
---@return table
---@overload fun(e: Entity, object: "ext:Thing"): ext.Thing
---@overload fun(e: Entity, object: "game:Boss"): game.Boss
---@overload fun(e: Entity, object: "game:Hero"): game.Hero
function world.dump(e, object) end
